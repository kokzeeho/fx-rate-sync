<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.heritage.fxpull</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/KokZee/FX Rate Sync - Do not delete/scripts/pull_fx_repo.sh</string>
    </array>

    <!-- Runs every time you log in or your Mac wakes, AND every 30 minutes
         while it's awake. The wake/login trigger alone missed updates when a
         transient network hiccup happened right at wake time (as happened on
         13 Sep) — the 30-minute interval means a failed attempt quietly
         retries itself within half an hour instead of waiting for the next
         login or wake. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>StandardOutPath</key>
    <string>/Users/KokZee/FX Rate Sync - Do not delete/scripts/fx-pull-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/KokZee/FX Rate Sync - Do not delete/scripts/fx-pull-launchd.log</string>
</dict>
</plist>
